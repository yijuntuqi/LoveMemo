# LoveMemo 后端环境变量配置示例
# 复制此文件为 .env 并填入真实值

# ============ 数据库 ============
# 推荐 Neon (https://neon.tech) 免费 Serverless PostgreSQL
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# ============ JWT 认证 ============
JWT_SECRET=your-secret-key-change-me

# ============ AI 服务 ============
# Moonshot (Kimi) 申请: https://platform.moonshot.cn/
AI_PROVIDER=moonshot
AI_BASE_URL=https://api.moonshot.cn/v1
AI_API_KEY=your-moonshot-api-key
AI_MODEL=moonshot-v1-8k

# ============ 高德地图 ============
# 申请: https://lbs.amap.com/
AMAP_KEY=your-amap-key

# ============ 邮件服务 ============
# QQ 邮箱授权码获取: 设置 → 账户 → POP3/SMTP → 开启 → 生成授权码
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_ALLOW_INVALID_CERTS=false
SMTP_USER=your-email@qq.com
SMTP_PASS=your-smtp-authorization-code

# 发件人显示名 (注意加引号)
FROM_EMAIL="LoveMemo <your-email@qq.com>"
