{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LoveMemo",
  "version": "1.0.0",
  "identifier": "com.lovememo.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LoveMemo 恋爱纪念册",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https://asset.localhost blob: data: https://*.tile.openstreetmap.org https://*.basemaps.cartocdn.com https://*.is.autonavi.com https://webrd*.is.autonavi.com https://wprd*.is.autonavi.com; media-src 'self' asset: http://asset.localhost https://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' http: https:;",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "requireLiteralLeadingDot": false,
          "allow": ["**/*"]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/lovememo-server"],
    "copyright": "© 2026 张异. All rights reserved.",
    "category": "Social Networking",
    "shortDescription": "记录情侣每一个心动瞬间——时间线、AI润色、恋爱地图、PDF纪念册",
    "longDescription": "LoveMemo 恋爱纪念册是专属于情侣的恋爱回忆管理工具，提供时间线、AI智能润色、恋爱足迹地图、PDF纪念册导出、多主题切换等核心功能。",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "perMachine",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "installerHooks": "nsis/hooks.nsh"
      },
      "wix": {
        "language": "zh-CN",
        "upgradeCode": "B7E9D8F2-3A6B-4C1D-9E5F-8A2B3C4D5E6F"
      }
    }
  }
}
